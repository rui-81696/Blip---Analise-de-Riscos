{
  "name": "blip-risk-analysis",
  "version": "1.0.0",
  "description": "Blip Risk Analysis - Aplicação Web para análise de risco em apostas desportivas",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../tests && npm install",
    "test:latency": "cd tests && npm run test:latency",
    "test:webllm": "cd tests && npm run test:webllm",
    "test:webllm:headed": "cd tests && npm run test:webllm:headed"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2"
  }
}
